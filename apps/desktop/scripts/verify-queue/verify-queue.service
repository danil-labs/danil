[Unit]
Description=Cola de trabajos pesados (verificación y CI)
After=network-online.target verify-egress.service
Wants=network-online.target
Requires=verify-egress.service

[Service]
User=verify
Environment=VERIFY_QUEUE_HOME=/var/lib/verify-queue
Environment=VERIFY_QUEUE_CONFIG=/etc/verify-queue/repos.json
Environment=PATH=/opt/rust/cargo/bin:/usr/local/bin:/usr/bin:/bin
Environment=RUSTUP_HOME=/opt/rust/rustup
Environment=VERIFY_QUEUE_NAME=linux-x64
ExecStart=/usr/bin/env node /opt/verify-queue/server.mjs
Restart=always
RestartSec=2
KillMode=process

[Install]
WantedBy=multi-user.target
