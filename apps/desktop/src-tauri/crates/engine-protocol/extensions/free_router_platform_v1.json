{
  "version": 1,
  "name": "free_router_platform",
  "description": "Pase del Free router de plataforma (plan v8, terminus-workspace#72; contrato danil-contracts platform/free-router). set_free_router_union une el workspace a un account de plataforma con la persona de la sesión de la interfaz (null al cerrar sesión); free_router_binding da {jkt, nonce}; prove_free_router_binding firma la prueba del reto; set_free_router_grant instala el pase firmado por workspaces ({sealed}); clear_free_router_grant lo borra y sube la generación. Solo interfaz (ventana o relay con caller person). Fuera del hash de compatibilidad (status.contract): sin este rasgo, la interfaz deja el Router cerrado en lo que no es personal.",
  "features": [
    "free_router_platform_v1"
  ],
  "commands": [
    {
      "async": false,
      "channel": null,
      "ids": {
        "workspace": [
          "workspace"
        ]
      },
      "kind": "invoke",
      "name": "set_free_router_union",
      "output": "-> Result < Value , String >",
      "parameters": [
        {
          "key": "workspace",
          "name": "workspace",
          "type": "String"
        },
        {
          "key": "platformAccount",
          "name": "platform_account",
          "type": "Option < String >"
        },
        {
          "key": "org",
          "name": "org",
          "type": "Option < String >"
        },
        {
          "key": "sub",
          "name": "sub",
          "type": "Option < String >"
        }
      ],
      "path": "rpc::set_free_router_union",
      "scope": "workspace",
      "audience": "window",
      "authority": "admin",
      "durable": false,
      "enforcement": "server"
    },
    {
      "async": false,
      "channel": null,
