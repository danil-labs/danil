{
  "version": 1,
  "name": "secret-request",
  "description": "Un agente pide a la persona un secreto env_secret que le falta (docs/account-credentials.md § Solicitudes de secreto). Fuera de la huella de commands.json: un motor sin esta capacidad no anuncia secret_request_v1 en status.service_features. Ninguna orden ni evento lleva el valor; la persona lo guarda por env_secret_set o la copia sellada de la cuenta.",
  "features": [
    "secret_request_v1"
  ],
  "events": [
    "secret_requested",
    "secret_request_closed"
  ],
  "commands": [
    {
      "async": false,
      "channel": null,
      "kind": "invoke",
      "name": "secret_request_answer",
      "output": "-> Result < SecretRequestAnswered , Failure >",
      "parameters": [
        {
          "key": "requestId",
          "name": "request_id",
          "type": "String"
        },
        {
          "key": "outcome",
          "name": "outcome",
          "type": "String"
        }
      ],
      "path": "secret_requests::secret_request_answer",
      "scope": "workspace",
      "audience": "window",
      "authority": "admin",
      "durable": false,
      "enforcement": "server"
    },
    {
      "async": false,
      "channel": null,
      "kind": "invoke",
      "name": "secret_requests_list",
      "output": "-> Result < SecretRequestsList , Failure >",
      "parameters": [
        {
          "key": "session",
          "name": "session",
          "type": "Option < String >"
        }
      ],
      "path": "secret_requests::secret_requests_list",
      "scope": "workspace",
      "audience": "window",
      "authority": "admin",
      "durable": false,
      "enforcement": "server"
    },
    {
      "kind": "cli",
      "name": "secret request",
      "path": "secret request",
      "flags": [
        "name*",
        "folder",
        "reason",
        "replace!",
        "wait"
      ],
      "writes": false,
      "audience": "public",
      "authority": "task",
      "durable": false,
      "relay": false,
      "enforcement": "server"
    }
  ]
}
