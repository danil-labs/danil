{
  "app": {
    "windows": [
      {
        "title": "Danil",
        "width": 1000,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "minWidth": 720,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": false,
        "create": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "./windows/installer.ico",
        "sidebarImage": "./windows/nsis-sidebar.bmp",
        "headerImage": "./windows/nsis-header.bmp"
      }
    }
  }
}
