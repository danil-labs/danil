    "debug": "4.4.3",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.15.0",
    "eslint-plugin-solid": "0.19.0",
    "jsdom": "^30.1.2",
    "material-icon-theme": "^5.37.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
