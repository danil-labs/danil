{
  "openapi": "3.1.0",
  "info": {
    "title": "Danil /v1: borde para el MVP del front",
    "version": "0.1.0-draft",
    "description": "Contrato PROPUESTO del borde /v1 para el MVP del front (F0.3). Derivado de los docs/API.md de edge, identity, machine-provisioning y relay. Los objetos aceptan campos aditivos; los clientes deben tolerarlos. No acredita implementación.",
    "license": {
      "name": "Proprietary",
      "identifier": "LicenseRef-Proprietary"
    }
  },
  "servers": [
    {
      "url": "https://edge.danil.ai",
      "description": "beta"
    },
    {
      "url": "https://api.danil.ai",
      "description": "producción"
    }
  ],
  "security": [
    {
      "webCookie": []
    },
    {
      "edgeBearer": []
    }
  ],
  "tags": [
    {
      "name": "identity",
      "description": "Persona y organizaciones"
    },
    {
      "name": "workspaces",
      "description": "Workspaces"
    },
    {
      "name": "machines",
      "description": "Máquinas, vía relay"
    },
    {
      "name": "operations",
      "description": "Operaciones asíncronas"
    },
    {
      "name": "credentials",
      "description": "Cuentas de IA"
    }
  ],
  "paths": {
    "/v1/identity/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Perfil de la persona y sus organizaciones",
        "tags": [
          "identity"
        ],
        "responses": {
          "200": {
            "description": "Perfil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/identity/organizations": {
      "get": {
        "operationId": "getOrganizations",
        "summary": "Organizaciones de la persona",
        "tags": [
          "identity"
        ],
        "responses": {
          "200": {
            "description": "Organizaciones",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/identity/organizations/select": {
      "post": {
        "operationId": "selectOrganization",
        "summary": "Fija la organización activa",
        "tags": [
          "identity"
        ],
        "description": "Efecto exacto sobre la cookie no documentado; el cliente debe releer getMe.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectOrganizationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Organización activa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectOrganizationResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Reautenticación requerida (organization_auth_required) u otro conflicto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/workspaces": {
      "get": {
        "operationId": "getWorkspaces",
        "summary": "Lista los workspaces",
        "tags": [
          "workspaces"
        ],
        "responses": {
          "200": {
            "description": "Workspaces",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "createWorkspace",
        "summary": "Crea un workspace",
        "tags": [
          "workspaces"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWorkspaceRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Workspace creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "422": {
            "description": "Petición inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/workspaces/select": {
      "post": {
        "operationId": "selectWorkspace",
        "summary": "Selecciona el workspace activo",
        "tags": [
          "workspaces"
        ],
        "description": "Requiere el scope workspaces.select e Idempotency-Key.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectWorkspaceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Workspace seleccionado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectWorkspaceResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/machines": {
      "get": {
        "operationId": "getMachines",
        "summary": "Lista las máquinas visibles para la persona",
        "tags": [
          "machines"
        ],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Valor de next_cursor de la página anterior."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Tamaño de página; el servidor puede acotarlo."
          }
        ],
        "responses": {
          "200": {
            "description": "Página de máquinas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MachineList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/machines/{id}": {
      "get": {
        "operationId": "getMachine",
        "summary": "Detalle de una máquina",
        "tags": [
          "machines"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/MachineId"
          }
        ],
        "responses": {
          "200": {
            "description": "Máquina",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Machine"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/machines/{id}/start": {
      "post": {
        "operationId": "startMachine",
        "summary": "Enciende una máquina",
        "tags": [
          "machines"
        ],
        "description": "Asíncrono: sondear getOperation.",
        "parameters": [
          {
            "$ref": "#/components/parameters/MachineId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "202": {
            "description": "Operación aceptada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Estado incompatible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/machines/{id}/stop": {
      "post": {
        "operationId": "stopMachine",
        "summary": "Apaga una máquina",
        "tags": [
          "machines"
        ],
        "description": "Asíncrono: sondear getOperation.",
        "parameters": [
          {
            "$ref": "#/components/parameters/MachineId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "202": {
            "description": "Operación aceptada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Estado incompatible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/machines/{id}/tickets": {
      "post": {
        "operationId": "createMachineTicket",
        "summary": "Ticket de un solo uso para abrir la sesión",
        "tags": [
          "machines"
        ],
        "description": "El ticket va en el subprotocolo de wss://connect.danil.ai/v1/machines/{id}/session. Un solo uso.",
        "parameters": [
          {
            "$ref": "#/components/parameters/MachineId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "200": {
            "description": "Ticket",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MachineTicket"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "machine_unreachable: el motor está desconectado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/operations/{id}": {
      "get": {
        "operationId": "getOperation",
        "summary": "Estado de una operación",
        "tags": [
          "operations"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/credentials/providers": {
      "get": {
        "operationId": "listCredentialProviders",
        "summary": "Proveedores de IA habilitados y estado de la conexión de la persona",
        "tags": [
          "credentials"
        ],
        "description": "Forma completa en platform/credentials-v1/openapi/public.openapi.json; aquí solo el mínimo tolerante.",
        "responses": {
          "200": {
            "description": "Proveedores",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CredentialProviderList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/credentials/providers/{provider}/connections": {
      "post": {
        "operationId": "connectCredentialProvider",
        "summary": "Inicia la conexión de la persona con un proveedor",
        "tags": [
          "credentials"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Provider"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Loose"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Conexión iniciada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Loose"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/credentials/providers/{provider}/connections/me": {
      "delete": {
        "operationId": "disconnectCredentialProvider",
        "summary": "Desconecta a la persona del proveedor",
        "tags": [
          "credentials"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Provider"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "204": {
            "description": "Desconectado"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "webCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-danil_session",
        "description": "Sesión web. Los POST de la web llevan además X-CSRF-Token (de GET /csrf)."
      },
      "edgeBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Portador de sesión (Desk)."
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "MachineId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "machine_id, p. ej. mch_..."
      },
      "Provider": {
        "name": "provider",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Sin sesión válida",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Sin permiso",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "NotFound": {
        "description": "No existe",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Error": {
        "description": "Error. Decidir por error.code, no por el estado HTTP.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": true
      },
      "Problem": {
        "type": "object",
        "description": "application/problem+json que emite el borde; type es urn:danil:problem:<code>.",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "Loose": {
        "type": "object",
        "additionalProperties": true
      },
      "OrganizationRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Abierto; hoy se observa personal."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": true
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "workspace": {
            "description": "Workspace activo si lo hay; forma no verificada.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/Workspace"
              },
              {
                "type": "null"
              }
            ]
          },
          "organizations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganizationRef"
            }
          },
          "active_organization_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": true
      },
      "OrganizationList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganizationRef"
            }
          },
          "organizations": {
            "type": "array",
            "description": "Alias posible; la forma exacta no está documentada.",
            "items": {
              "$ref": "#/components/schemas/OrganizationRef"
            }
          },
          "active_organization_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      },
      "SelectOrganizationRequest": {
        "type": "object",
        "properties": {
          "organization_id": {
            "type": "string"
          }
        },
        "required": [
          "organization_id"
        ],
        "additionalProperties": true
      },
      "SelectOrganizationResponse": {
        "type": "object",
        "properties": {
          "active_organization_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      },
      "Workspace": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "org": {
            "type": "string"
          },
          "name": {
