{
  "version": 1,
  "name": "remote_child",
  "description": "Hijas pedidas por una tarea de otra computadora de la cuenta. Fuera del hash de compatibilidad (status.contract). cli_flags son flags que la capacidad suma a rutas del CLI que ya existen.",
  "features": [
    "remote_child_v1"
  ],
  "commands": [
    {
      "async": false,
      "channel": null,
      "kind": "invoke",
      "name": "create_remote_child",
      "output": "-> Result < RemoteChild , String >",
      "parameters": [
        {
          "key": "provider",
          "name": "provider",
          "type": "String"
        },
        {
          "key": "project",
          "name": "project",
          "type": "String"
        },
        {
          "key": "prompt",
          "name": "prompt",
          "type": "String"
        },
        {
          "key": "model",
          "name": "model",
          "type": "Option < String >"
        },
        {
          "key": "effort",
          "name": "effort",
          "type": "Option < String >"
        },
        {
          "key": "permissionMode",
          "name": "permission_mode",
          "type": "String"
        },
        {
          "key": "baseRef",
          "name": "base_ref",
          "type": "Option < String >"
        },
        {
          "key": "space",
          "name": "space",
          "type": "Option < String >"
        },
        {
          "key": "remoteParent",
          "name": "remote_parent",
          "type": "RemoteParent"
        },
        {
          "key": "depth",
          "name": "depth",
          "type": "u32"
        },
        {
          "key": "hops",
          "name": "hops",
          "type": "u32"
        },
        {
          "key": "fromTask",
          "name": "from_task",
          "type": "Option < crate :: wire :: Wire < crate :: sessions :: SenderTask > >"
        }
      ],
      "path": "remote_child::create_remote_child",
      "scope": "workspace",
      "relay": true,
      "audience": "window",
      "authority": "admin",
      "durable": false,
      "enforcement": "server"
    }
  ],
  "cli_flags": {
    "task send": [
      "machine"
    ],
    "task read": [
      "machine"
    ],
    "task show": [
      "machine"
    ]
  }
}
