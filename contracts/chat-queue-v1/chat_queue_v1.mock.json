          "engine": "turn_running",
          "turn_id": "7f3c2a1e-0b4d-4c8e-9a51-2d6f0e8b1a01"
        },
        {
          "call": {
            "command": "get_turn",
            "args": {
              "project": "prj_fixture",
              "session": "ses_fixture"
            }
          },
          "result": {
            "state": "running",
            "turn_id": "7f3c2a1e-0b4d-4c8e-9a51-2d6f0e8b1a01"
          }
        },
        {
          "call": {
            "command": "stop_turn_if",
            "args": {
              "project": "prj_fixture",
              "session": "ses_fixture",
              "turnId": "7f3c2a1e-0b4d-4c8e-9a51-2d6f0e8b1a01"
            }
          },
          "result": {
            "outcome": "stop_requested"
          }
        },
        {
          "engine": "turn_closing",
          "turn_id": "7f3c2a1e-0b4d-4c8e-9a51-2d6f0e8b1a01"
        },
        {
          "call": {
            "command": "get_turn",
            "args": {
              "project": "prj_fixture",
              "session": "ses_fixture"
            }
          },
          "result": {
            "state": "closing",
            "turn_id": "7f3c2a1e-0b4d-4c8e-9a51-2d6f0e8b1a01"
          }
        },
        {
          "call": {
            "command": "stop_turn_if",
            "args": {
              "project": "prj_fixture",
              "session": "ses_fixture",
              "turnId": "7f3c2a1e-0b4d-4c8e-9a51-2d6f0e8b1a01"
            }
          },
          "result": {
            "outcome": "closing"
          }
        },
        {
          "engine": "turn_closed",
          "turn_id": "7f3c2a1e-0b4d-4c8e-9a51-2d6f0e8b1a01"
        },
        {
          "call": {
            "command": "get_turn",
            "args": {
              "project": "prj_fixture",
              "session": "ses_fixture"
            }
          },
          "result": {
            "state": "idle"
          }
        }
      ],
      "expect": {
        "launched_turns": 0,
        "stop_requested": [
          "7f3c2a1e-0b4d-4c8e-9a51-2d6f0e8b1a01"
        ]
      }
    },
