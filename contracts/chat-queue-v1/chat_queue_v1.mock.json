{
  "_comment": "Mock con guion de chat_queue_v1 para el arnés de la ventana (T0 en danil) y para la prueba del manifiesto. Valores de mentira.",
  "format": {
    "version": 1,
    "features": [
      "chat_queue_v1"
    ],
    "scenario": "{name, description, steps: [step], expect: {launched_turns, stop_requested}}",
    "call_step": "{call: {command, args}, result} o {call: {command, args}, error}: el arnés espera esta llamada en este orden; command debe ser igual y args debe contener cada clave y valor del paso (la llamada puede traer más claves). Contesta result como respuesta correcta o error como error RPC. starts_turn: el send_message lanzó ese turno (running).",
    "engine_step": "{engine, turn_id?}: lo que pasa en el motor entre dos llamadas, sin llamada del cliente. El arnés no contesta nada: avanza al paso siguiente. engine: turn_starting, turn_running, turn_closing, turn_closed (con turn_id) o engine_restart (los turnos no sobreviven; las claves de clientMessageId sí).",
    "end": "Una llamada que no coincide con el paso siguiente, o que llega después del último, es un fallo del escenario.",
    "expect": "launched_turns: cuántos turnos lanzó send_message en todo el escenario; stop_requested: los turn_id con stop_turn_if aceptado. Lo comprueba quien replica el guion, no el arnés."
  },
  "scenarios": [
    {
      "name": "running_a",
      "description": "Turno running con turn_id A: Detener lo pide, A cierra y la tarea queda idle.",
      "steps": [
